{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "lib": [
      "esnext"
    ],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./gen/srv",
    "baseUrl": ".",
    "paths": {
      "@cds-models/*": [
        "./@cds-models/*"
      ],
      "@sap/cds": [
        "./node_modules/@cap-js/cds-types"
      ],
      "#cds-models/*": [
        "./@cds-models/*"
      ]
    },
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "allowJs": true,
    "noEmit": false
  },
  "include": [
    "srv"
  ]
}