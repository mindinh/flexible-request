{
    "authenticationMethod": "route",
    "sessionTimeout": 30,
    "welcomeFile": "/index.html",
    "routes": [
        {
            "source": "^/odata/v4/(.*)$",
            "target": "/odata/v4/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa",
            "csrfProtection": true
        },
        {
            "source": "^/admin/(.*)$",
            "target": "/admin/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa",
            "csrfProtection": true
        },
        {
            "source": "^/browse/(.*)$",
            "target": "/browse/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa",
            "csrfProtection": true
        },
        {
            "source": "^/identity/(.*)$",
            "target": "/identity/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa",
            "csrfProtection": true
        },
        {
            "source": "^/assets/(.*)$",
            "target": "/assets/$1",
            "localDir": "resources",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/docs/(.*)$",
            "target": "/docs/$1",
            "localDir": "resources",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/(.*\\.(?:js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map|html))$",
            "target": "/$1",
            "localDir": "resources",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/(.*)$",
            "target": "/index.html",
            "localDir": "resources",
            "authenticationType": "xsuaa"
        }
    ],
    "logout": {
        "logoutEndpoint": "/do/logout"
    }
}